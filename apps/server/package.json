    "hono": "4.10.4",
    "jose": "6.1.0",
    "nanoid": "5.1.6",
    "pdfkit": "0.17.2",
    "postgres": "3.4.7",
    "svg-to-pdfkit": "0.1.8",
    "undici": "7.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pdfkit": "0.17.3",
    "esbuild": "0.25.11",
    "pdf-parse": "1.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}

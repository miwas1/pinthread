# Copy to .env for local development. Production: set these in your host's environment settings.

# Postgres connection string (managed Postgres in production; add ?sslmode=require if your host needs TLS)
DATABASE_URL=postgres://pinthread:pinthread@localhost:5432/pinthread

# Nexconn app (console.nexconn.ai). Leave both empty to run with the built-in local chat for development.
# The App Secret must only ever live on the server.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API domains for your app's data centre (console / docs.nexconn.ai "Base URL").
# Singapore: api.sg-light-api.com / api-b.sg-light-api.com
NEXCONN_PRIMARY_API_DOMAIN=api.sg-light-api.com
NEXCONN_SECONDARY_API_DOMAIN=api-b.sg-light-api.com
# Optional: SG, NA or SAU. Inferred from the primary domain when unset; must match the console.
NEXCONN_AREA=

# Public origin of the deployed app, used in invite links and image URLs sent through Nexconn.
# On Render this defaults to RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:8787

# Random strings (e.g. `openssl rand -hex 32`). Required in production.
SESSION_SECRET=
INVITE_SECRET=
# Protects /api/admin/metrics?key=...
ADMIN_KEY=

# Demo tuning
DEMO_POOL_SIZE=5
DEMO_TTL_HOURS=48
MAX_DEMO_CLAIMS_PER_DAY=400
